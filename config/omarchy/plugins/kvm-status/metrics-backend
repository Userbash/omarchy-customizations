#!/bin/sh
# Read-only KVM/VPN probe. It does not start, stop, or reconfigure anything.
set -u

proc_root=${OMARCHY_KVM_PROC_ROOT:-/proc}
sys_net_root=${OMARCHY_KVM_SYS_CLASS_NET_ROOT:-/sys/class/net}
kvm_device_path=${OMARCHY_KVM_DEVICE_PATH:-/dev/kvm}

kvm_device=0
[ -e "$kvm_device_path" ] && kvm_device=1
kvm_amd=0
kvm_intel=0
grep -qw kvm_amd "$proc_root/modules" 2>/dev/null && kvm_amd=1
grep -qw kvm_intel "$proc_root/modules" 2>/dev/null && kvm_intel=1

# Count processes that can hold /dev/kvm. The process scan is deliberately
# bounded to /proc and does not require lsof or elevated privileges.
vm_count=0
vm_names=""
for proc in "$proc_root"/[0-9]*; do
  [ -r "$proc/comm" ] || continue
  comm=$(cat "$proc/comm" 2>/dev/null || true)
  case "$comm" in
    qemu-system-*|qemu-kvm|cloud-hypervisor|firecracker|crosvm)
      vm_count=$((vm_count + 1))
      [ -n "$vm_names" ] && vm_names="$vm_names, "
      vm_names="$vm_names$comm"
      ;;
  esac
done

vpn_active=0
vpn_name=""
for path in "$sys_net_root"/*; do
  iface=${path##*/}
  case "$iface" in
    throne-tun|tun[0-9]*|tap[0-9]*|wg[0-9]*|tailscale[0-9]*)
      [ -r "$path/operstate" ] || continue
      state=$(cat "$path/operstate" 2>/dev/null || true)
      if [ "$state" = up ] || [ "$state" = unknown ]; then
        vpn_active=1
        [ -n "$vpn_name" ] && vpn_name="$vpn_name, "
        vpn_name="$vpn_name$iface"
      fi
      ;;
  esac
done

# Throne can expose its tunnel as UNKNOWN, so also account for its process.
for proc in "$proc_root"/[0-9]*; do
  [ -r "$proc/comm" ] || continue
  comm=$(cat "$proc/comm" 2>/dev/null || true)
  case "$comm" in
    Throne|ThroneCore|openvpn|wg-quick|tailscaled)
      vpn_active=1
      [ -n "$vpn_name" ] || vpn_name="private-network"
      ;;
  esac
done

jq -cn \
  --argjson kvm_device "$kvm_device" \
  --argjson kvm_amd "$kvm_amd" \
  --argjson kvm_intel "$kvm_intel" \
  --argjson vm_count "$vm_count" \
  --arg vm_names "$vm_names" \
  --argjson vpn_active "$vpn_active" \
  --arg vpn_name "$vpn_name" \
  '{kvm_device:$kvm_device,kvm_amd:$kvm_amd,kvm_intel:$kvm_intel,vm_count:$vm_count,vm_names:$vm_names,vpn_active:$vpn_active,vpn_name:$vpn_name}'
